# Check the delivered bundle without re-running Blender. Source-only edits need
# refreshed source pins; rendered geometry/textures must not change unnoticed.
if(NOT DEFINED SOURCE_DIR)
    message(FATAL_ERROR "SOURCE_DIR is required")
endif()
foreach(manifest scenes/fixtures/export_contract.manifest.json scenes/harbor/manifest.json)
    file(READ "${SOURCE_DIR}/${manifest}" document)
    string(JSON count LENGTH "${document}" artifacts)
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
        # Validate both content digest and size, including authoring source files.
        string(JSON path GET "${document}" artifacts ${index} path)
        string(JSON expected_hash GET "${document}" artifacts ${index} sha256)
        string(JSON expected_size GET "${document}" artifacts ${index} bytes)
        if(NOT EXISTS "${SOURCE_DIR}/${path}")
            message(FATAL_ERROR "Missing pinned artifact: ${path}")
        endif()
        file(SHA256 "${SOURCE_DIR}/${path}" actual_hash)
        file(SIZE "${SOURCE_DIR}/${path}" actual_size)
        if(NOT actual_hash STREQUAL expected_hash OR NOT actual_size EQUAL expected_size)
            message(FATAL_ERROR "Pinned artifact changed: ${path}; expected ${expected_hash}/${expected_size}, got ${actual_hash}/${actual_size}")
        endif()
    endforeach()
    message(STATUS "PASS ${manifest}: ${count} source/asset hashes and byte sizes")
endforeach()
# Check high-level authoring invariants recorded by the export validator:
# a named perspective view, closed water, a single sky/sun setup, and asset license.
file(READ "${SOURCE_DIR}/scenes/harbor/manifest.json" document)
string(JSON camera GET "${document}" export_audit camera name)
string(JSON closed GET "${document}" export_audit water_topology closed_oriented_manifold)
string(JSON sun_disk GET "${document}" environment has_sun_disk)
string(JSON license GET "${document}" licenses 0 spdx)
if(NOT camera STREQUAL "Reference" OR NOT closed OR sun_disk OR NOT license STREQUAL "CC0-1.0")
    message(FATAL_ERROR "Harbor camera, water, sky, or asset-license contract failed")
endif()
# The visual reference is protected input, never part of the generated asset set.
file(SHA256 "${SOURCE_DIR}/Reference.png" reference_hash)
if(NOT reference_hash STREQUAL "23b769091d8e46e5cbeac5ee75d7b311ef1c4a97980de169960935af5447bd58")
    message(FATAL_ERROR "Reference.png integrity changed")
endif()
message(STATUS "PASS camera, closed-water manifest, no duplicate sky sun, CC0 assets, and preserved reference")

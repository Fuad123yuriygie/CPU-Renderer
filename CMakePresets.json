{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "mingw-base", "hidden": true, "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "C:/mingw64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/mingw64/bin/ninja.exe",
        "BUILD_TESTING": "ON"
      }
    },
    { "name": "mingw-debug", "inherits": "mingw-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "mingw-release", "inherits": "mingw-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } }
  ],
  "buildPresets": [
    { "name": "mingw-debug", "configurePreset": "mingw-debug", "jobs": 4 },
    { "name": "mingw-release", "configurePreset": "mingw-release", "jobs": 4 }
  ],
  "testPresets": [
    { "name": "mingw-debug", "configurePreset": "mingw-debug", "output": { "outputOnFailure": true } },
    { "name": "mingw-release", "configurePreset": "mingw-release", "output": { "outputOnFailure": true } }
  ]
}
